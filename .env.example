# ── Required ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
DISCORD_BOT_TOKEN=

# Path to your org profile (defaults to config/org.json, then config/org.example.json)
# ORG_CONFIG=config/org.json

# ── Notion (each database is optional; unset ones are simply not exposed) ──
NOTION_TOKEN=
NOTION_CONTENT_INSIGHTS_DB=
NOTION_WEEKLY_UPDATES_DB=
NOTION_CONTENT_BRIEFS_DB=
NOTION_SOCIAL_DRAFTS_DB=
NOTION_PIPELINE_DB=
NOTION_CHANNEL_MEMORY_DB=

# ── GitHub (optional, feeds "what shipped this week") ─────
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# ── Email: configure Gmail OR Outlook (optional) ──────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_REFRESH_TOKEN=
